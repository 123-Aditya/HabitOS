<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Evaluated ONCE per JVM start -->
    <timestamp key="STARTUP_TS"
               datePattern="yyyy-MM-dd_HH-mm-ss"/>

    <property name="LOG_PATH" value="logs"/>
    <property name="APP_NAME" value="habit-tracker"/>

    <!-- Console appender -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- File appender (NO rolling) -->
    <appender name="FILE"
              class="ch.qos.logback.core.FileAppender">

        <!-- One file per restart -->
        <file>
            ${LOG_PATH}/${APP_NAME}-${STARTUP_TS}.log
        </file>

        <append>true</append>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
